# pnpm config for the web/ project.
#
# - `auto-install-peers=true` matches the npm/yarn default so React's
#   peers (e.g. @types/react needing react) install without nags.
# - `strict-peer-dependencies=false` keeps the install from failing on
#   benign peer-range warnings from older dev tooling.
# - `engine-strict=true` honours the `engines.node` field in package.json
#   so CI fails fast when the wrong Node is selected.
auto-install-peers=true
strict-peer-dependencies=false
engine-strict=true
